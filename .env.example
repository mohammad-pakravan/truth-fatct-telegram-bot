BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername
CONTACT_USERNAME=YourSupportUsername

# Postgres (docker-compose overrides host to db)
POSTGRES_USER=jorat
POSTGRES_PASSWORD=jorat_secret
POSTGRES_DB=jorat
DATABASE_URL=postgresql+psycopg2://jorat:jorat_secret@localhost:5432/jorat

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=profiles
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
