BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername
CONTACT_USERNAME=YourSupportUsername

# Bootstrap bot admins (comma-separated Telegram user IDs). Always admins.
# More admins can be added from /admin panel.
# Sponsored channels are per-province: assign each channel to a province in /admin.
ADMIN_IDS=123456789
# Optional: admin broadcast rate (default 20 msg/s; stay under ~30)
# BROADCAST_RATE_PER_SECOND=20

# Inline Mode (group/channel start via @BOT_USERNAME in any chat):
# 1) BotFather → Bot Settings → Inline Mode → Enable
# 2) Inline Feedback → set to ~100% (needed for chosen_inline_result)
# 3) BOT_USERNAME above must match the bot username

# If api.telegram.org times out (common on restricted networks):
# TELEGRAM_PROXY=socks5://host:1080
# TELEGRAM_CONNECT_TIMEOUT=20
# TELEGRAM_READ_TIMEOUT=30

# Match queue worker
# MATCH_QUEUE_TTL_MINUTES=45
# MATCH_JOB_INTERVAL_SECONDS=3
# MATCH_BATCH_SIZE=80

# Postgres (docker-compose overrides host to db)
POSTGRES_USER=jorat
POSTGRES_PASSWORD=jorat_secret
POSTGRES_DB=jorat
DATABASE_URL=postgresql+psycopg2://jorat:jorat_secret@localhost:5432/jorat

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=profiles
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
